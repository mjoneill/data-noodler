# Never commit credentials. They live in ~/.config, outside this repo.
# The OAuth client's real filename is data-noodler-client.json
# (ga-mcp-client.json before #1999; both stay excluded).
*adc*.json
*client_secret*.json
*data-noodler-client*.json
*ga-mcp-client*.json
*-client.json
credentials.json
application_default_credentials.json

# Analysis output is someone's real traffic: it never belongs here.
*.html
*.csv
*.xlsx
!data-noodler/tests/fixtures/*.csv
_outputs/

# Build output
dist/

# Python
__pycache__/
*.pyc

# Local harness settings
.claude/settings.local.json
.claude/worktrees/

# macOS
.DS_Store
